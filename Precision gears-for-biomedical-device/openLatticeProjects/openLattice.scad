
/*
  BoneScaffoldAI — parametric prototype
  --------------------------------------
  Modes:
    "lattice"  = generate a simple porous lattice in OpenSCAD
    "import"   = import a porous STL generated by Scaffolder

  IMPORTANT:
  This is an engineering prototype, NOT a clinically validated implant.
  Verify dimensions, mesh quality, material, strength, and biocompatibility
  before considering any medical use.
*/

// -------------------- USER PARAMETERS --------------------

// Choose "lattice" for the built-in demo.
// Choose "import" after generating meshes/scaffold.stl with Scaffolder.
model_mode = "lattice";

// Overall specimen dimensions, in millimetres
scaffold_diameter = 12;
scaffold_height   = 20;

// Built-in lattice settings
cell_size = 4;
strut_radius = 0.55;

// Imported STL settings
stl_scale = 1.0;
stl_file = "../meshes/scaffold.stl";

// Optional base and top plates
add_end_plates = false;
plate_thickness = 1.0;
plate_extra_radius = 0.5;

// Optional axial mounting hole
add_center_hole = false;
center_hole_diameter = 2.0;

// Preview quality
$fn = 32;

// -------------------- BASIC GEOMETRY --------------------

module specimen_boundary() {
    cylinder(
        h = scaffold_height,
        d = scaffold_diameter,
        center = false 
    );
}

module center_hole() {
    if (add_center_hole) {
        translate([0, 0, -0.1])
            cylinder(
                h = scaffold_height + 0.2,
                d = center_hole_diameter,
                center = false
            );
    }
}

// A rounded strut joining two 3D points.
// hull() creates a continuous beam between the endpoint spheres.
module strut_between(p1, p2, r = strut_radius) {
    hull() {
        translate(p1) sphere(r = r);
        translate(p2) sphere(r = r);
    }
}

// -------------------- SIMPLE POROUS LATTICE --------------------

// Generate vertical struts on a square grid.
// The intersection with the cylindrical boundary clips the lattice
// to the specimen's outside shape.
module vertical_struts() {
    for (
        x = [-scaffold_diameter/2 : cell_size : scaffold_diameter/2],
        y = [-scaffold_diameter/2 : cell_size : scaffold_diameter/2]
    ) {
        strut_between(
            [x, y, 0],
            [x, y, scaffold_height]
        );
    }
}

// Generate horizontal struts along X.
module x_struts() {
    for (
        z = [cell_size/2 : cell_size : scaffold_height-cell_size/2],
        y = [-scaffold_diameter/2 : cell_size : scaffold_diameter/2]
    ) {
        strut_between(
            [-scaffold_diameter/2, y, z],
            [ scaffold_diameter/2, y, z]
        );
    }
}

// Generate horizontal struts along Y.
module y_struts() {
    for (
        z = [cell_size/2 : cell_size : scaffold_height-cell_size/2],
        x = [-scaffold_diameter/2 : cell_size : scaffold_diameter/2]
    ) {
        strut_between(
            [x, -scaffold_diameter/2, z],
            [x,  scaffold_diameter/2, z]
        );
    }
}

// Optional solid plates at the top and bottom.
// They are unioned with the lattice before the centre hole is cut.
module end_plates() {
    if (add_end_plates) {
        translate([0, 0, 0])
            cylinder(
                h = plate_thickness,
                d = scaffold_diameter + 2*plate_extra_radius
            );

        translate([0, 0, scaffold_height-plate_thickness])
            cylinder(
                h = plate_thickness,
                d = scaffold_diameter + 2*plate_extra_radius
            );
    }
}

// Built-in lattice prototype.
module lattice_scaffold() {
    difference() {
        intersection() {
            specimen_boundary();

            union() {
                vertical_struts();
                x_struts();
                y_struts();
                end_plates();
            }
        }

        center_hole();
    }
}

// -------------------- IMPORTED SCAFFOLDER MESH --------------------

module imported_scaffold() {
    difference() {
        scale([stl_scale, stl_scale, stl_scale])
            import(stl_file, convexity = 10);

        // Leave this hole off unless the imported mesh is aligned
        // around the origin and the hole is intentionally required.
        if (add_center_hole) {
            translate([0, 0, -1000])
                cylinder(
                    h = 2000,
                    d = center_hole_diameter
                );
        }
    }
}

// -------------------- FINAL MODEL --------------------

if (model_mode == "lattice") {
    lattice_scaffold();
}
else if (model_mode == "import") {
    imported_scaffold();
}
else {
    // An invalid mode produces a visible diagnostic object.
    %cube([5, 5, 5], center = true);
}

